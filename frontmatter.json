{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "npm run dev",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.taxonomy.dateFormat": "yyyy-MM-dd'T'HH:mm:ssXXX",
  "frontMatter.templates.prefix": "",
  "frontMatter.content.autoUpdateDate": false,
  "frontMatter.taxonomy.seoDescriptionField": "description",
  "frontMatter.dashboard.content.card.fields.description": "description",
  "frontMatter.content.pageFolders": [
    {
      "title": "Yazılar",
      "path": "[[workspace]]/content/posts",
      "contentTypes": [
        "default"
      ],
      "filePrefix": "",
      "excludePaths": [
        "_index*.md"
      ]
    },
    {
      "title": "Projeler",
      "path": "[[workspace]]/content/projects",
      "contentTypes": [
        "projects",
        "page"
      ],
      "filePrefix": "",
      "excludePaths": [
        "_index*.md"
      ]
    },
    {
      "title": "Bit Pazarı",
      "path": "[[workspace]]/content/market",
      "contentTypes": [
        "market"
      ],
      "filePrefix": "",
      "excludePaths": [
        "_index*.md"
      ]
    },
    {
      "title": "Sayfalar",
      "path": "[[workspace]]/content/pages",
      "contentTypes": [
        "page"
      ],
      "filePrefix": "",
      "excludePaths": [
        "_index*.md"
      ]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "filePrefix": "",
      "clearEmpty": true,
      "postScript": "fix-filename",
      "fields": [
        {
          "title": "Başlık",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Açıklama (Google ve link önizlemeleri)",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Yayın tarihi",
          "name": "date",
          "type": "datetime",
          "isPublishDate": true,
          "default": "{{now}}"
        },
        {
          "title": "Son güncelleme",
          "name": "lastmod",
          "type": "datetime",
          "isModifiedDate": true
        },
        {
          "title": "Taslak",
          "name": "draft",
          "type": "draft",
          "default": true
        },
        {
          "title": "Yazı tipi",
          "name": "postType",
          "type": "choice",
          "default": "article",
          "choices": [
            {
              "id": "article",
              "title": "Makale"
            },
            {
              "id": "snippet",
              "title": "Snippet"
            },
            {
              "id": "video",
              "title": "Video"
            }
          ]
        },
        {
          "title": "Video (YouTube adresi ya da dosya adı)",
          "name": "video",
          "type": "string",
          "single": true,
          "when": {
            "fieldRef": "postType",
            "operator": "eq",
            "value": "video"
          }
        },
        {
          "title": "Anasayfada tamamını göster",
          "name": "fullContent",
          "type": "boolean",
          "default": false,
          "when": {
            "fieldRef": "postType",
            "operator": "eq",
            "value": "article"
          }
        },
        {
          "title": "İçindekiler",
          "name": "toc",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Etiketler",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Kategoriler",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Alt başlık",
          "name": "subtitle",
          "type": "string",
          "single": true
        },
        {
          "title": "İngilizce adres (sadece .en.md)",
          "name": "slug",
          "type": "string",
          "single": true
        },
        {
          "title": "Anasayfada gizle",
          "name": "hiddenFromHomePage",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "name": "market",
      "pageBundle": true,
      "defaultFileName": "index",
      "filePrefix": "",
      "clearEmpty": true,
      "postScript": "fix-filename",
      "fields": [
        {
          "title": "Ürün adı",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Kısa açıklama",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Eklenme tarihi",
          "name": "date",
          "type": "datetime",
          "isPublishDate": true,
          "default": "{{now}}"
        },
        {
          "title": "Son güncelleme",
          "name": "lastmod",
          "type": "datetime",
          "isModifiedDate": true
        },
        {
          "title": "Taslak",
          "name": "draft",
          "type": "draft",
          "default": true
        },
        {
          "title": "Fiyat (boş = \"Fiyat için sorun\")",
          "name": "price",
          "type": "number",
          "numberOptions": {
            "isDecimal": false,
            "min": 0
          }
        },
        {
          "title": "Durum",
          "name": "status",
          "type": "choice",
          "default": "available",
          "choices": [
            {
              "id": "available",
              "title": "Satışta"
            },
            {
              "id": "reserved",
              "title": "Rezerve"
            },
            {
              "id": "sold",
              "title": "Satıldı"
            }
          ]
        },
        {
          "title": "Kondisyon",
          "name": "condition",
          "type": "choice",
          "default": "good",
          "choices": [
            {
              "id": "new",
              "title": "Sıfır"
            },
            {
              "id": "like-new",
              "title": "Sıfır ayarında"
            },
            {
              "id": "good",
              "title": "İyi"
            },
            {
              "id": "fair",
              "title": "Kullanılmış"
            }
          ]
        },
        {
          "title": "Özellikler",
          "name": "specs",
          "type": "block",
          "fieldGroup": [
            "spec"
          ]
        },
        {
          "title": "İlan linkleri",
          "name": "links",
          "type": "block",
          "fieldGroup": [
            "listing"
          ]
        }
      ]
    },
    {
      "name": "projects",
      "pageBundle": true,
      "defaultFileName": "_index",
      "filePrefix": "",
      "clearEmpty": true,
      "postScript": "fix-filename",
      "fields": [
        {
          "title": "Proje adı",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Kısa açıklama",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Sıra (küçük olan önce)",
          "name": "weight",
          "type": "number",
          "default": 10
        },
        {
          "title": "Platformlar",
          "name": "platforms",
          "type": "choice",
          "multiple": true,
          "choices": [
            "Android",
            "iOS",
            "Web",
            "macOS",
            "Windows",
            "Linux"
          ]
        },
        {
          "title": "Linkler",
          "name": "links",
          "type": "fields",
          "fields": [
            {
              "title": "App Store",
              "name": "appStore",
              "type": "string",
              "single": true
            },
            {
              "title": "Google Play",
              "name": "googlePlay",
              "type": "string",
              "single": true
            },
            {
              "title": "Web sitesi",
              "name": "website",
              "type": "string",
              "single": true
            },
            {
              "title": "GitHub",
              "name": "github",
              "type": "string",
              "single": true
            }
          ]
        },
        {
          "title": "Yayın ayarları",
          "name": "build",
          "type": "fields",
          "hidden": true,
          "fields": [
            {
              "title": "Orijinal görselleri yayınla",
              "name": "publishResources",
              "type": "boolean",
              "default": false
            }
          ]
        }
      ]
    },
    {
      "name": "page",
      "pageBundle": false,
      "allowAsSubContent": true,
      "filePrefix": "",
      "clearEmpty": true,
      "postScript": "fix-filename",
      "fields": [
        {
          "title": "Başlık",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Açıklama",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Tarih",
          "name": "date",
          "type": "datetime",
          "isPublishDate": true,
          "default": "{{now}}"
        },
        {
          "title": "Son güncelleme",
          "name": "lastmod",
          "type": "datetime",
          "isModifiedDate": true
        },
        {
          "title": "Taslak",
          "name": "draft",
          "type": "draft",
          "default": true
        },
        {
          "title": "İngilizce adres (sadece .en.md)",
          "name": "slug",
          "type": "string",
          "single": true
        },
        {
          "title": "Site içi aramada gizle",
          "name": "hiddenFromSearch",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Sitemap",
          "name": "sitemap",
          "type": "fields",
          "fields": [
            {
              "title": "Sitemap'ten çıkar",
              "name": "disable",
              "type": "boolean",
              "default": false
            }
          ]
        }
      ]
    }
  ],
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "spec",
      "labelField": "name",
      "fields": [
        {
          "title": "Özellik",
          "name": "name",
          "type": "string",
          "single": true
        },
        {
          "title": "Değer",
          "name": "value",
          "type": "string",
          "single": true
        }
      ]
    },
    {
      "id": "listing",
      "labelField": "name",
      "fields": [
        {
          "title": "Site (Sahibinden, Letgo…)",
          "name": "name",
          "type": "string",
          "single": true
        },
        {
          "title": "İlan adresi",
          "name": "url",
          "type": "string",
          "single": true
        }
      ]
    }
  ],
  "frontMatter.custom.scripts": [
    {
      "id": "create-translation",
      "title": "İngilizce çevirisini oluştur",
      "script": "./.frontmatter/scripts/create-translation.mjs",
      "command": "node",
      "type": "content"
    },
    {
      "id": "fix-filename",
      "title": "Dosya adını düzelt",
      "script": "./.frontmatter/scripts/fix-filename.mjs",
      "command": "node",
      "type": "content",
      "hidden": true
    }
  ],
  "frontMatter.taxonomy.tags": [
    "amd",
    "apache",
    "button 5 not working",
    "böte doktora",
    "böte yüksek lisans",
    "c sharp",
    "cmd",
    "css temel ölçüler",
    "dark theme",
    "dependency injection",
    "django",
    "elektronik oy kullanma cihazı",
    "gigabyte b450",
    "github pages",
    "google captcha",
    "hardware",
    "hugo",
    "lisansüstü eğitim",
    "localhost",
    "logitech m560",
    "macos",
    "mobil programlama",
    "mongodb",
    "mustafa dizdar",
    "nginx",
    "oracle",
    "php",
    "php debugger",
    "python",
    "remote access",
    "responsive",
    "reymatik",
    "statik blog",
    "temiz kurulum",
    "terminal",
    "ubuntu",
    "virtualization",
    "visual studio code",
    "whatsapp",
    "windows",
    "xdebug"
  ],
  "frontMatter.taxonomy.categories": [
    "Bilgisayar ve Öğretim Teknolojileri",
    "CSS",
    "Django",
    "Dotnet",
    "Flutter",
    "Kişisel",
    "Linux",
    "Nasıl Yapılır",
    "PHP",
    "Projeler",
    "Python",
    "Veritabanı",
    "Web Programlama"
  ]
}